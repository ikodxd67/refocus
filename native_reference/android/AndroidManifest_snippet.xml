<!--
  Merge these into android/app/src/main/AndroidManifest.xml.
  The <service> goes INSIDE <application>; the queries/permission go at the
  <manifest> top level.
-->

<!-- Needed on Android 11+ to see other apps' package names -->
<queries>
    <intent>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
    </intent>
</queries>

<!-- Inside <application> ... </application> -->
<service
    android:name=".FocusAccessibilityService"
    android:exported="false"
    android:label="Refocus focus guard"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
    <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
</service>

